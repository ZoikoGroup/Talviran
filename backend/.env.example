DATABASE_URL=postgresql+asyncpg://talvrin_app:talvrin_app@localhost:5433/talvrin
ADMIN_DATABASE_URL=postgresql+asyncpg://talvrin:talvrin@localhost:5433/talvrin

# A separate database for tests/integration (infra/init-db/02-test-database.sql
# creates it automatically on a fresh volume; run
#   ADMIN_DATABASE_URL=$TEST_ADMIN_DATABASE_URL uv run alembic upgrade head
# once to apply the schema to it - see backend/README.md's Testing section).
TEST_DATABASE_URL=postgresql+asyncpg://talvrin_app:talvrin_app@localhost:5433/talvrin_test
TEST_ADMIN_DATABASE_URL=postgresql+asyncpg://talvrin:talvrin@localhost:5433/talvrin_test

REDIS_URL=redis://localhost:6380/0
DMO_BASE_URL=https://www.dmo.gov.uk
SECRET_KEY=dev-only-change-me
ENVIRONMENT=development

# Supabase Auth (GoTrue) — Project Settings -> API in the Supabase dashboard.
# This is the project's API base URL, NOT a Postgres connection string.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Not read by anything yet; reserved for a future admin operation.
# SUPABASE_SERVICE_ROLE_KEY=

# Gemini embeddings (P4 EVID-001 E3 semantic retrieval) and generation
# (P4b ai_gateway, talvrin-pro). Only needed to run those pipelines -
# everything else works without it.
# GEMINI_API_KEY=

# Groq generation (P4b ai_gateway, talvrin-go). Not yet used live in this
# project - see ai_gateway/providers/groq_client.py.
# GROQ_API_KEY=
